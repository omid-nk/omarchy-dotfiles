#!/bin/bash

SERVER=""
USERNAME=""
PASSWORD=""

# VPN server certificate pin
SERVER_CERT="pin-sha256:/6q4rvPpKqeIM8vJrB2u4kN21rdIM6V3ptWKXNhILTQ="

SCRIPT="/etc/vpnc/vpnc-script"
TUNNEL="tun0"


show_header() {
    clear
    echo " ────────────────────────────────────────── "
    echo "              ⚡ OMARCHY VPN                "
    echo " ────────────────────────────────────────── "
    printf "  Server   %-28s \n" "$SERVER"
    printf "  User     %-28s \n" "$USERNAME"
    echo " ────────────────────────────────────────── "
    echo
}


is_connected() {
    pgrep -x openconnect >/dev/null 2>&1 &&
    ip link show "$TUNNEL" >/dev/null 2>&1
}


connect_vpn() {

    if is_connected; then
        echo "● VPN is already connected."
        exit 0
    fi

    echo "● Connecting to $SERVER..."
    echo

    echo "$PASSWORD" | sudo openconnect \
        "$SERVER" \
        --user="$USERNAME" \
        --passwd-on-stdin \
        --servercert="$SERVER_CERT" \
        --script="$SCRIPT" \
        --background

    echo "● Waiting for VPN..."

    for i in {1..15}; do
        if is_connected; then
            break
        fi

        sleep 1
    done

    if is_connected; then

        echo "● Refreshing network..."

        sudo systemctl restart NetworkManager

        sleep 5

        echo
        echo "✓ VPN CONNECTED"
        echo

        ip addr show "$TUNNEL" | grep "inet "

    else

        echo
        echo "✗ VPN FAILED"
        echo

        sudo pkill -x openconnect 2>/dev/null

        return 1
    fi
}


disconnect_vpn() {

    if ! pgrep -x openconnect >/dev/null 2>&1; then
        echo "● VPN is not running."
        exit 0
    fi

    echo "● Disconnecting VPN..."

    sudo pkill -x openconnect

    sleep 2

    echo "✓ VPN disconnected."
}


status_vpn() {

    if is_connected; then

        echo "● VPN STATUS: CONNECTED"

        if ip link show "$TUNNEL" >/dev/null 2>&1; then
            echo
            echo "Interface:"
            ip addr show "$TUNNEL" | grep "inet "
        fi

    else

        echo "● VPN STATUS: DISCONNECTED"

    fi
}


case "$1" in

    "")
        show_header
        connect_vpn
        ;;

    start|connect)
        show_header
        connect_vpn
        ;;

    stop|disconnect)
        show_header
        disconnect_vpn
        ;;

    restart)
        show_header
        disconnect_vpn
        sleep 2
        connect_vpn
        ;;

    status)
        show_header
        status_vpn
        ;;

    *)
        show_header
        echo "Usage:"
        echo
        echo "  vpn              Connect"
        echo "  vpn start        Connect"
        echo "  vpn stop         Disconnect"
        echo "  vpn status       Status"
        echo "  vpn restart      Restart"
        ;;

esac
